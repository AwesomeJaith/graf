# HydraDB connection (Bolt, Neo4j-driver compatible). Point this at any
# HydraDB instance/graph — Graf adapts via @workspace/graph-schema, no code
# changes needed to switch databases.
# Use bolt:// for a single dev node (neo4j:// triggers cluster routing
# discovery, which a lone node doesn't implement — see hydradb README).
HYDRADB_BOLT_URL=bolt://127.0.0.1:7687
HYDRADB_HTTP_URL=http://127.0.0.1:8443
HYDRADB_AUTH_TOKEN=local-development-token-32-bytes
HYDRADB_NAMESPACE=default
HYDRADB_GRAPH_ID=default
HYDRADB_CELL_ID=cell-0

# Optional: path to a GraphSchema JSON file describing a non-default graph.
# GRAF_SCHEMA_PATH=./schema.json

# AWS Bedrock (LLM inference + embeddings). Uses the default AWS credential
# chain (aws configure / SSO / env vars) — no keys committed here.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Shared-password gate for the app (apps/web/proxy.ts) — one password for the
# whole deployment, no user accounts. SESSION_SECRET signs the session cookie:
# generate one with `node -e "console.log(crypto.randomBytes(32).toString('base64url'))"`.
SITE_PASSWORD=change-me
SESSION_SECRET=change-me
