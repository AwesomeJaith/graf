# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# turbo
.turbo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# proprietary
prompts/

# generated embeddings sidecar (reproducible via `pnpm run seed:demo` +
# `pnpm --filter @workspace/bench run ingest`, ~9MB, not worth committing) —
# one pattern rather than a line per index base, since every run of the ingest
# scripts can name a new one (sample, full, demo, ...)
packages/bench/data/vector-index.*.json
# binary sidecars written alongside each index descriptor above
packages/bench/data/vector-index.*.meta.jsonl
packages/bench/data/vector-index.*.vectors.bin
# node body text held out of the graph (see ContentStore) — several GB
packages/bench/data/vector-index.*.content.jsonl
packages/bench/data/vector-index.*.content.idx

# full upstream EnterpriseRAG-Bench corpus (~4GB clone, re-fetchable, never commit)
packages/bench/data/enterprise-rag-bench-full/

# superseded scoring runs, kept locally for comparison but not part of the
# record: `*.judge-v1.json` predates the tool-use judge (see src/judge.ts), and
# `*-partial*.json` is where an interrupted run left off
packages/bench/data/results/*.judge-v1.json
packages/bench/data/results/*-partial*.json

# ingest-full.ts scratch: disk-backed link/embed queues + shard checkpoint,
# several GB, regenerated by re-running the ingest
packages/bench/data/full-ingest/
# the same scratch from running ingest-full.ts over the sample slice to build
# the hosted deployment's index (apps/web/data/vector-index.hosted.*)
packages/bench/data/hosted-ingest/

# local HydraDB dev node state
.hydradb/

# local chat-history sqlite db
.data/
