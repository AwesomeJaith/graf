# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# turbo
.turbo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# proprietary
prompts/

# generated embeddings sidecar (reproducible via `pnpm run seed:demo` +
# `pnpm --filter @workspace/bench run ingest`, ~9MB, not worth committing)
packages/bench/data/vector-index.sample.json
packages/bench/data/vector-index.full.json
# binary sidecars written alongside each index descriptor above
packages/bench/data/vector-index.*.meta.jsonl
packages/bench/data/vector-index.*.vectors.bin

# full upstream EnterpriseRAG-Bench corpus (~4GB clone, re-fetchable, never commit)
packages/bench/data/enterprise-rag-bench-full/

# local HydraDB dev node state
.hydradb/

# local chat-history sqlite db
.data/
